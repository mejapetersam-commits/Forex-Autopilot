# Copy values into your deployment secret manager or an untracked .env file.
# Never commit real secrets.
APP_ENV=production
FOREX_AUTOPILOT_BRIDGE_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
FOREX_AUTOPILOT_TELEMETRY_DB=/var/lib/forex-autopilot/telemetry.sqlite3

# Symbols shown as active on the dashboard (historical quote rows are retained).
FOREX_AUTOPILOT_DASHBOARD_SYMBOLS=EURUSDm,GBPUSDm

# Separate dashboard operator credential; use a different random secret.
FOREX_AUTOPILOT_ADMIN_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Demo execution is deliberately disabled. Enable only after EA compilation and demo validation.
FOREX_AUTOPILOT_ENVIRONMENT=demo
FOREX_AUTOPILOT_DEMO_EXECUTION_ENABLED=false
# Empty means no instrument can be dispatched; explicitly allowlist only tested symbols.
FOREX_AUTOPILOT_EXECUTION_SYMBOLS=
FOREX_AUTOPILOT_EXECUTION_STATE_STALE_SECONDS=20
FOREX_AUTOPILOT_EXECUTION_MAGIC=61119001
FOREX_AUTOPILOT_MAX_DAILY_LOSS_PCT=1.0
FOREX_AUTOPILOT_MAX_OPEN_POSITIONS=1
FOREX_AUTOPILOT_MAX_VOLUME_LOTS=0.01
FOREX_AUTOPILOT_MAX_RISK_PER_TRADE_PCT=0.25
FOREX_AUTOPILOT_MAX_SPREAD_PIPS=2.0

# Local scheduled SQLite backup policy (Docker Compose).
FOREX_AUTOPILOT_BACKUP_INTERVAL_SECONDS=86400
FOREX_AUTOPILOT_BACKUP_RETENTION_DAYS=30

FOREX_AUTOPILOT_HEALTH_MONITOR_INTERVAL_SECONDS=30
FOREX_AUTOPILOT_TELEMETRY_STALE_AFTER_SECONDS=60
