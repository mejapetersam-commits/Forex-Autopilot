worker_processes auto;
pid /tmp/nginx.pid;

events {
    worker_connections 256;
}

http {
    access_log /dev/stdout;
    error_log /dev/stderr warn;
    client_max_body_size 2m;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;

    upstream forex_autopilot_api {
        server api:8000;
        keepalive 8;
    }

    server {
        listen 8080;
        server_name _;

        # Only authenticated, read-only MT5 telemetry and candle ingestion
        # routes are reachable through this gateway. All other paths are denied.
        location = /api/v1/mt5/specifications {
            limit_except POST { deny all; }
            if ($content_type !~* "^application/json(?:\\s*;.*)?$") { return 415; }
            proxy_pass http://forex_autopilot_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_connect_timeout 5s;
            proxy_send_timeout 10s;
            proxy_read_timeout 10s;
        }

        location = /api/v1/mt5/heartbeat {
            limit_except POST { deny all; }
            if ($content_type !~* "^application/json(?:\\s*;.*)?$") { return 415; }
            proxy_pass http://forex_autopilot_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_connect_timeout 5s;
            proxy_read_timeout 10s;
        }

        location = /api/v1/mt5/account {
            limit_except POST { deny all; }
            if ($content_type !~* "^application/json(?:\\s*;.*)?$") { return 415; }
            proxy_pass http://forex_autopilot_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_connect_timeout 5s;
            proxy_read_timeout 10s;
        }

        location = /api/v1/mt5/quote {
            limit_except POST { deny all; }
            if ($content_type !~* "^application/json(?:\\s*;.*)?$") { return 415; }
            proxy_pass http://forex_autopilot_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_connect_timeout 5s;
            proxy_read_timeout 10s;
        }

        # Authenticated broker deal-history telemetry only; never execution commands.
        location = /api/v1/mt5/execution/history {
            limit_except POST { deny all; }
            if ($content_type !~* "^application/json(?:\\s*;.*)?$") { return 415; }
            proxy_pass http://forex_autopilot_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_connect_timeout 5s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
        }

        # Authenticated demo broker order-history telemetry only.
        location = /api/v1/mt5/execution/orders {
            limit_except POST { deny all; }
            if ($content_type !~* "^application/json(?:\\s*;.*)?$") { return 415; }
            proxy_pass http://forex_autopilot_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_connect_timeout 5s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
        }

        # Position snapshots, deal history and order history from the demo telemetry EA.
        location = /api/v1/mt5/execution/state {
            limit_except POST { deny all; }
            if ($content_type !~* "^application/json(?:\\s*;.*)?$") { return 415; }
            proxy_pass http://forex_autopilot_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_connect_timeout 5s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
        }

        # Authenticated demo execution command polling.
        location = /api/v1/mt5/execution/commands/next {
            limit_except GET { deny all; }
            proxy_pass http://forex_autopilot_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_connect_timeout 5s;
            proxy_send_timeout 10s;
            proxy_read_timeout 10s;
        }

        # Authenticated demo execution result callback.
        location ~ ^/api/v1/mt5/execution/commands/[A-Za-z0-9_-]+/result$ {
            limit_except POST { deny all; }
            if ($content_type !~* "^application/json(?:\\s*;.*)?$") { return 415; }
            proxy_pass http://forex_autopilot_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_connect_timeout 5s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
        }
        location = /api/v1/mt5/candles/bulk {
            limit_except POST { deny all; }
            if ($content_type !~* "^application/json(?:\\s*;.*)?$") { return 415; }
            proxy_pass http://forex_autopilot_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_connect_timeout 5s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
        }

        location = /api/v1/mt5/candles {
            limit_except POST { deny all; }
            if ($content_type !~* "^application/json(?:\\s*;.*)?$") { return 415; }
            proxy_pass http://forex_autopilot_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_connect_timeout 5s;
            proxy_read_timeout 10s;
        }

        location = / {
            default_type text/html;
            return 200 '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Forex Autopilot</title><style>body{margin:0;background:#101827;color:#edf2f7;font:16px Arial,sans-serif;display:grid;min-height:100vh;place-items:center}.card{max-width:560px;margin:24px;padding:36px;border:1px solid #34445b;border-radius:18px;background:#182438}h1{margin-top:0;font-size:30px}.status{color:#55d6a0;font-weight:bold}.muted{color:#a9b8ca;line-height:1.7}.pill{display:inline-block;padding:7px 12px;border-radius:20px;background:#153c35;color:#73e0b5;font-size:13px}</style></head><body><main class="card"><span class="pill">TELEMETRY GATEWAY</span><h1>Forex Autopilot</h1><p class="status">● Gateway online</p><p class="muted">The secure telemetry service is running. MT5 connectivity and market-data ingestion are handled through protected API endpoints.</p><p class="muted">Automated trading: <strong>DISABLED</strong></p></main></body></html>';
        }

        location / {
            return 404;
        }
    }
}
